{% comment %}
  SHATTA Article Template
  Displays individual blog article with full content
{% endcomment %}

<style>
  .article-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.5);
    font-weight: 300;
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }

  .article-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .article-breadcrumb a:hover {
    color: #1A1A1A;
  }

  .breadcrumb-separator {
    margin: 0 0.5rem;
  }

  .article-header {
    margin-bottom: 3rem;
  }

  .article-meta-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.6);
  }

  .article-category {
    display: inline-block;
    background-color: rgba(196, 163, 90, 0.1);
    color: #C4A35A;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .article-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.1;
    margin: 1rem 0 2rem;
  }

  .article-excerpt {
    color: rgba(26, 26, 26, 0.7);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid #E8E0D4;
    border-bottom: 1px solid #E8E0D4;
    margin-bottom: 3rem;
  }

  .author-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #E8E0D4;
  }

  .author-details-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    color: #1A1A1A;
  }

  .author-date {
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.5);
  }

  .article-content {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.8;
    color: #1A1A1A;
  }

  .article-content h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
    margin: 3rem 0 1rem;
    color: #1A1A1A;
  }

  .article-content h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
    color: #1A1A1A;
  }

  .article-content p {
    margin-bottom: 1.5rem;
    text-align: justify;
  }

  .article-content ul,
  .article-content ol {
    margin: 2rem 0;
    padding-left: 2rem;
  }

  .article-content li {
    margin-bottom: 0.75rem;
  }

  .article-content img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
    margin: 3rem 0;
  }

  .article-content blockquote {
    border-left: 4px solid #C4A35A;
    padding-left: 2rem;
    margin: 2rem 0;
    font-style: italic;
    color: rgba(26, 26, 26, 0.7);
  }

  .article-footer {
    margin-top: 6rem;
    padding: 3rem 0;
    border-top: 1px solid #E8E0D4;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .article-tag {
    background-color: rgba(232, 224, 212, 0.3);
    border: 1px solid #E8E0D4;
    color: #1A1A1A;
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.3s;
  }

  .article-tag:hover {
    background-color: #E8E0D4;
    color: #C4A35A;
  }

  .related-articles {
    margin-top: 6rem;
  }

  .related-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-align: center;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .related-card {
    border-radius: 1.5rem;
    overflow: hidden;
    background-color: white;
    border: 1px solid #E8E0D4;
    transition: all 0.3s;
  }

  .related-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: #C4A35A;
  }

  .related-image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
  }

  .related-card:hover .related-image img {
    transform: scale(1.05);
  }

  .related-content {
    padding: 1.5rem;
  }

  .related-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #1A1A1A;
  }

  .related-card:hover .related-card-title {
    color: #C4A35A;
  }

  .related-card-excerpt {
    font-size: 0.875rem;
    color: rgba(26, 26, 26, 0.7);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #E8E0D4;
  }

  .nav-link {
    text-decoration: none;
    color: #1A1A1A;
    transition: color 0.3s;
  }

  .nav-link:hover {
    color: #C4A35A;
  }

  .nav-label {
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .nav-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .nav-arrow {
    font-weight: 300;
  }
</style>

<article class="article-container">
  {% comment %} Breadcrumb {% endcomment %}
  <div class="article-breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-separator">/</span>
    <a href="/blogs/journal">Journal</a>
    <span class="breadcrumb-separator">/</span>
    <span style="color: #C4A35A; font-weight: 500;">{{ article.title }}</span>
  </div>

  {% comment %} Article Header {% endcomment %}
  <header class="article-header">
    <div class="article-meta-info">
      {% if article.tags %}
        <span class="article-category">{{ article.tags.first }}</span>
      {% endif %}
    </div>
    
    <h1 class="article-title">{{ article.title }}</h1>
    
    {% if article.excerpt %}
      <p class="article-excerpt">{{ article.excerpt | strip_html }}</p>
    {% endif %}

    <div class="article-author">
      <div class="author-details-info">
        <span class="author-name">{{ article.author }}</span>
        <span class="author-date">{{ article.published_at | date: "%B %d, %Y" }}</span>
      </div>
    </div>
  </header>

  {% comment %} Article Image {% endcomment %}
  {% if article.image %}
    <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title }}" style="width: 100%; border-radius: 1rem; margin-bottom: 3rem;">
  {% endif %}

  {% comment %} Article Content {% endcomment %}
  <div class="article-content">
    {{ article.content }}
  </div>

  {% comment %} Article Footer {% endcomment %}
  <footer class="article-footer">
    {% comment %} Tags {% endcomment %}
    {% if article.tags.size > 0 %}
      <div class="article-tags">
        {% for tag in article.tags %}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="article-tag">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} Navigation {% endcomment %}
    <nav class="article-nav" aria-label="Article navigation">
      {% if article.previous_article %}
        <a href="{{ article.previous_article.url }}" class="nav-link" rel="prev" aria-label="Previous article: {{ article.previous_article.title }}">
          <div class="nav-label">← Previous Article</div>
          <div class="nav-title">{{ article.previous_article.title }}</div>
        </a>
      {% else %}
        <div></div>
      {% endif %}

      {% if article.next_article %}
        <a href="{{ article.next_article.url }}" class="nav-link" style="text-align: right;" rel="next" aria-label="Next article: {{ article.next_article.title }}">
          <div class="nav-label">Next Article →</div>
          <div class="nav-title">{{ article.next_article.title }}</div>
        </a>
      {% endif %}
    </nav>
  </footer>
</article>

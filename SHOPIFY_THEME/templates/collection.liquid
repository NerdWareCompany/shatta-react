{% comment %}
  SHATTA Collection Template
  Handles product filtering, sorting, and grid display
{% endcomment %}

<style>
  .collection-page {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    padding: 2rem;
    max-width: 90rem;
    margin: 0 auto;
  }
  
  /* Sidebar Filters */
  .filters-sidebar {
    background-color: #F9F9F9;
    border-radius: 1rem;
    padding: 1.5rem;
    height: fit-content;
    position: sticky;
    top: 100px;
  }
  
  .filter-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    margin-bottom: 1rem;
  }
  
  .filter-group {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #E8E0D4;
  }
  
  .filter-group:last-child {
    border-bottom: none;
  }
  
  .filter-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #1A1A1A;
    margin-bottom: 0.5rem;
    cursor: pointer;
  }
  
  .filter-label input {
    margin: 0;
    width: 1.15em;
    height: 1.15em;
    cursor: pointer;
  }
  
  /* Main Content */
  .collection-main {
    display: flex;
    flex-direction: column;
  }
  
  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .collection-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
  }
  
  .collection-controls {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  
  .sort-select {
    padding: 0.5rem 1rem;
    border: 1px solid #E8E0D4;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    background-color: white;
    cursor: pointer;
  }
  
  .sort-select:focus {
    outline: none;
    border-color: #C4A35A;
  }
  
  .view-toggle {
    display: flex;
    gap: 0.5rem;
  }
  
  .view-btn {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E8E0D4;
    background-color: white;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .view-btn.active {
    background-color: #1A1A1A;
    color: white;
    border-color: #1A1A1A;
  }
  
  .view-btn:hover {
    border-color: #C4A35A;
  }
  
  /* Product Grid */
  .products-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
  }
  
  .product-card {
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  
  .product-image-wrapper {
    position: relative;
    aspect-ratio: 3/4;
    background-color: #F9F9F9;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  
  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
  }
  
  .product-card:hover .product-image {
    transform: scale(1.05);
  }
  
  .product-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(0.5rem);
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    z-index: 5;
  }
  
  .product-info {
    padding: 0 0.5rem;
  }
  
  .product-category {
    font-size: 0.75rem;
    color: #757575;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  
  .product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 0.5rem;
    min-height: 2.2em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .product-price {
    font-size: 1rem;
    font-weight: 600;
    color: #1A1A1A;
  }
  
  .product-price-sale {
    text-decoration: line-through;
    color: #757575;
    font-size: 0.875rem;
    margin-right: 0.5rem;
  }
  
  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }
  
  .pagination-btn {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E8E0D4;
    background-color: white;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.3s;
  }
  
  .pagination-btn:hover {
    border-color: #C4A35A;
  }
  
  .pagination-btn.active {
    background-color: #1A1A1A;
    color: white;
    border-color: #1A1A1A;
  }
  
  .pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  @media (max-width: 1024px) {
    .collection-page {
      grid-template-columns: 1fr;
    }
    
    .filters-sidebar {
      display: none;
    }
    
    .products-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  
  @media (max-width: 767px) {
    .collection-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .products-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<div class="collection-page">
  
  <!-- Sidebar Filters -->
  <aside class="filters-sidebar">
    <h3 class="filter-title">Filters</h3>
    
    <!-- Price Filter -->
    <div class="filter-group">
      <label style="display: block; margin-bottom: 1rem; font-weight: 600;">Price Range</label>
      <input type="range" min="0" max="10000" value="4500" style="width: 100%;">
      <div style="margin-top: 0.5rem; font-size: 0.875rem; color: rgba(26, 26, 26, 0.7);">
        EGP 0 - <span id="price-display">4,500</span>
      </div>
    </div>
    
    <!-- Category Filter -->
    <div class="filter-group">
      <label style="display: block; margin-bottom: 1rem; font-weight: 600;">Category</label>
      {% for category in collection.tags %}
        <label class="filter-label">
          <input type="checkbox" value="{{ category }}">
          <span>{{ category }}</span>
        </label>
      {% endfor %}
    </div>
    
    <!-- Color Filter -->
    <div class="filter-group">
      <label style="display: block; margin-bottom: 1rem; font-weight: 600;">Color</label>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;">
        {% assign theme_colors = '#F5F5DC:Beige,#FFFFFF:White,#A3B19B:Sage,#C7A4A4:Rose,#1A1A1A:Black,#E8E0D4:Sand' | split: ',' %}
        {% for color_entry in theme_colors %}
          {% assign color_parts = color_entry | split: ':' %}
          <button 
            style="width: 100%; height: 2rem; border-radius: 0.5rem; border: 1px solid #E8E0D4; cursor: pointer; transition: all 0.3s;"
            title="{{ color_parts[1] }}"
          >
            <span style="display: inline-block; width: 1rem; height: 1rem; border-radius: 50%; background-color: {{ color_parts[0] }};"></span>
          </button>
        {% endfor %}
      </div>
    </div>
    
    <!-- Material Filter -->
    <div class="filter-group">
      <label style="display: block; margin-bottom: 1rem; font-weight: 600;">Material</label>
      <label class="filter-label">
        <input type="checkbox" checked>
        <span>Egyptian Cotton</span>
      </label>
      <label class="filter-label">
        <input type="checkbox">
        <span>Silk</span>
      </label>
      <label class="filter-label">
        <input type="checkbox">
        <span>Linen</span>
      </label>
      <label class="filter-label">
        <input type="checkbox">
        <span>Wool</span>
      </label>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="collection-main">
    
    <!-- Header with Controls -->
    <div class="collection-header">
      <div>
        <h1 class="collection-title">{{ collection.title }}</h1>
        <p style="color: rgba(26, 26, 26, 0.6); font-size: 0.875rem;">
          {{ collection.products_count }} products
        </p>
      </div>
      
      <div class="collection-controls">
        <select class="sort-select" onchange="handleSort(this.value)">
          <option value="newest">Newest</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="best-sellers">Best Sellers</option>
        </select>
      </div>
    </div>

    {% paginate collection.products by 12 %}
    <!-- Products Grid -->
    <div class="products-container">
      {% for product in paginate.items %}
        <div class="product-card">
          <div class="product-image-wrapper">
            <img 
              src="{{ product.featured_image | img_url: '400x500' }}" 
              alt="{{ product.title }}"
              loading="lazy"
              class="product-image"
            >
            {% if product.metafields.custom.badge %}
              <span class="product-badge">{{ product.metafields.custom.badge }}</span>
            {% endif %}
          </div>
          <div class="product-info">
            <div class="product-category">{{ product.type }}</div>
            <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
              <h3 class="product-name">{{ product.title }}</h3>
            </a>
            <div class="product-price">
              {% if product.compare_at_price %}
                <span class="product-price-sale">{{ product.compare_at_price | money }}</span>
              {% endif %}
              <span>{{ product.price | money }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <nav class="pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination-btn">←</a>
        {% endif %}
        
        {% for page in (1..paginate.pages) %}
          {% if page == paginate.current_page %}
            <button class="pagination-btn active" disabled>{{ page }}</button>
          {% else %}
            <a href="{% if page == 1 %}{{ collection.url }}{% else %}{{ collection.url }}?page={{ page }}{% endif %}" class="pagination-btn">{{ page }}</a>
          {% endif %}
        {% endfor %}
        
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination-btn">→</a>
        {% endif %}
      </nav>
    {% endif %}
    {% endpaginate %}
  </div>
</div>

<script>
  // Price range slider
  const priceSlider = document.querySelector('input[type="range"]');
  if (priceSlider) {
    priceSlider.addEventListener('input', function() {
      document.getElementById('price-display').textContent = 
        parseInt(this.value).toLocaleString();
    });
  }
  
  function handleSort(value) {
    // Implement sort logic
  }
</script>

{% comment %}
  SHATTA Homepage Template
  Displays hero, categories, collections, and stats
{% endcomment %}

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: white;
  }
  
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.1) 100%);
    z-index: 1;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 50rem;
    text-align: center;
    color: white;
  }
  
  .hero-badge {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-weight: 500;
    backdrop-filter: blur(10px);
  }
  
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }
  
  .hero-subtitle {
    font-size: clamp(0.875rem, 2vw, 1.125rem);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 3rem;
    opacity: 0.95;
  }
  
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: #C4A35A;
    color: white;
    padding: 1rem 2.5rem;
    border: 2px solid #C4A35A;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .hero-cta:hover {
    background-color: #D4B97A;
    border-color: #D4B97A;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(196, 163, 90, 0.3);
  }
  
  /* Categories Grid */
  .categories-section {
    padding: 6rem 2rem;
    background-color: white;
  }
  
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    margin-bottom: 4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  
  .categories-grid {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  
  .category-card {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 1.5rem;
    cursor: pointer;
  }
  
  .category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
  }
  
  .category-card:hover img {
    transform: scale(1.05);
  }
  
  .category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.1) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .category-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    color: white;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  
  /* Products Section */
  .products-section {
    padding: 6rem 2rem;
    background-color: white;
  }
  
  .section-header {
    max-width: 80rem;
    margin: 0 auto 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }
  
  .tabs {
    display: flex;
    gap: 2rem;
    border-bottom: 1px solid #E8E0D4;
    padding-bottom: 1rem;
  }
  
  .tab {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(26, 26, 26, 0.6);
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s;
  }
  
  .tab.active {
    color: #1A1A1A;
    font-weight: 600;
  }
  
  .tab.active::after {
    content: '';
    position: absolute;
    bottom: -1rem;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #C4A35A;
  }
  
  .tab:hover {
    color: #1A1A1A;
  }
  
  .products-grid {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }
  
  .product-card {
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  
  .product-image-wrapper {
    position: relative;
    aspect-ratio: 3/4;
    background-color: #F9F9F9;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }
  
  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
  }
  
  .product-card:hover .product-image {
    transform: scale(1.05);
  }
  
  .product-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(0.5rem);
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  
  .product-info {
    padding: 0 0.5rem;
  }
  
  .product-category {
    font-size: 0.75rem;
    color: #757575;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  
  .product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 0.5rem;
    min-height: 2.2em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .product-price {
    font-size: 1rem;
    font-weight: 600;
    color: #1A1A1A;
  }
  
  /* Stats Section */
  .stats-section {
    padding: 6rem 2rem;
    background-color: #1A1A1A;
    color: white;
  }
  
  .stats-grid {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
  }
  
  .stat-card {
    text-align: center;
  }
  
  .stat-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    color: #C4A35A;
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  @media (max-width: 767px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .tabs {
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>

<style>
  .hp-hero-wrap {
    padding: 0.5rem 1rem 1.5rem;
  }

  .hp-hero {
    position: relative;
    width: 100%;
    height: 75vh;
    border-radius: 2.5rem;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
  }

  .hp-hero-parallax {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    transform: translate3d(0, var(--hp-hero-y, 0px), 0);
    transition: transform 60ms linear;
    will-change: transform;
  }

  .hp-hero-parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 15s ease-out;
  }

  .hp-hero:hover .hp-hero-parallax img {
    transform: scale(1.05);
  }

  .hp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.2), transparent);
  }

  .hp-hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 2.5rem;
    max-width: 56rem;
  }

  .hp-hero-kicker,
  .hp-hero-title,
  .hp-hero-copy,
  .hp-hero-actions {
    opacity: 0;
    transform: translateY(2.5rem);
    animation: hpFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hp-hero-kicker {
    color: #C4A35A;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    animation-delay: 0s;
  }

  .hp-hero-title {
    margin: 0 0 1.5rem;
    color: #FFFFFF;
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    line-height: 1.1;
    filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.04)) drop-shadow(0 4px 3px rgba(0, 0, 0, 0.1));
    animation-delay: 0.1s;
  }

  .hp-hero-copy {
    margin: 0 0 2.5rem;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.6;
    filter: drop-shadow(0 4px 3px rgba(0, 0, 0, 0.07)) drop-shadow(0 2px 2px rgba(0, 0, 0, 0.06));
    animation-delay: 0.2s;
  }

  .hp-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation-delay: 0.3s;
  }

  .hp-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    border-radius: 9999px;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-decoration: none;
    overflow: hidden;
    transform: scale(1);
    transition: transform 0.2s;
  }

  .hp-btn:hover {
    transform: scale(1.03);
  }

  .hp-btn:active {
    transform: scale(0.97);
  }

  .hp-btn-fill {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease-out;
    border-radius: 9999px;
  }

  [dir="rtl"] .hp-btn-fill {
    transform-origin: right;
  }

  .hp-btn:hover .hp-btn-fill {
    transform: scaleX(1);
  }

  .hp-btn-label {
    position: relative;
    z-index: 1;
  }

  .hp-btn-primary {
    color: #FFFFFF;
    background: #C4A35A;
    box-shadow: 0 10px 15px -3px rgba(196, 163, 90, 0.2);
  }

  .hp-btn-primary .hp-btn-fill {
    background: #B39249;
  }

  .hp-btn-secondary {
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .hp-btn-secondary .hp-btn-fill {
    background: #FFFFFF;
  }

  .hp-btn-secondary .hp-btn-label {
    transition: color 0.5s;
  }

  .hp-btn-secondary:hover .hp-btn-label {
    color: #1A1A1A;
  }

  .hp-category {
    padding: 3rem 1.5rem;
  }

  .hp-category-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .hp-category-row {
    display: flex;
    overflow-x: auto;
    gap: 0 1.5rem;
    padding: 0 0.5rem 1.5rem;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .hp-category-row::-webkit-scrollbar {
    display: none;
  }

  .hp-category-item {
    min-width: 85px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }

  .hp-reveal {
    opacity: 0;
    transform: translateY(2.5rem);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hp-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hp-category-circle {
    width: 85px;
    height: 85px;
    border-radius: 9999px;
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    border: 1px solid transparent;
    padding: 0.25rem;
    margin-bottom: 1rem;
    transition: all 0.5s;
  }

  .hp-category-item:hover .hp-category-circle {
    border-color: rgba(196, 163, 90, 0.5);
    box-shadow: 0 20px 25px -5px rgba(196, 163, 90, 0.2);
  }

  .hp-category-circle-inner {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
  }

  .hp-category-circle-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
    border-radius: 50%
  }

  .hp-category-item:hover .hp-category-circle-inner img {
    transform: scale(1.1);
  }

  .hp-category-wash {
    position: absolute;
    inset: 0;
    background: rgba(196, 163, 90, 0);
    transition: background-color 0.5s;
  }

  .hp-category-item:hover .hp-category-wash {
    background: rgba(196, 163, 90, 0.1);
  }

  .hp-category-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1A1A1A;
    transition: color 0.3s;
  }

  .hp-category-item:hover .hp-category-label {
    color: #C4A35A;
  }

  @media (min-width: 640px) {
    .hp-hero-actions {
      flex-direction: row;
    }
  }

  @media (min-width: 768px) {
    .hp-hero-wrap {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .hp-hero {
      height: 88vh;
    }

    .hp-hero-content {
      padding-left: 5rem;
      padding-right: 5rem;
    }

    .hp-hero-title {
      font-size: 4.5rem;
    }

    .hp-hero-copy {
      font-size: 1.25rem;
    }

    .hp-category-row {
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .hp-hero-content {
      padding-left: 7rem;
      padding-right: 7rem;
    }

    .hp-hero-title {
      font-size: 6rem;
    }
  }

  @keyframes hpFadeUp {
    from {
      opacity: 0;
      transform: translateY(2.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>


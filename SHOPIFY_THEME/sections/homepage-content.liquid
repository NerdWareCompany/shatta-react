<script>
  (function initHomepageHeroAndCategory() {
    const hero = document.getElementById('hp-hero');
    const parallax = document.getElementById('hp-hero-parallax');
    if (hero && parallax) {
      let ticking = false;
      const onScroll = function() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          const y = Math.min(window.scrollY * 0.25, 250);
          parallax.style.setProperty('--hp-hero-y', y + 'px');
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const reveals = document.querySelectorAll('#hp-shop-category .hp-reveal');
    if (!reveals.length) return;
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          const index = Array.prototype.indexOf.call(reveals, entry.target);
          entry.target.style.transitionDelay = (index * 0.1) + 's';
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -100px 0px' });
    reveals.forEach(function(node) { observer.observe(node); });
  })();
</script>

<!-- Flash Sale Section -->
<style>
  .flash-sale-banner {
    background-color: #1A1A1A;

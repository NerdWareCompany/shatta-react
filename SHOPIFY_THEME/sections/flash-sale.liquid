{% comment %}
  SHATTA Flash Sale Section
  Displays limited-time sale banner with countdown timer
  Features: Animated countdown, sale percentage, call-to-action button
{% endcomment %}

<style>
  .flash-sale-banner {
    background-color: #1A1A1A;
    border-radius: 2.5rem;
    padding: 2.5rem 2rem;
    margin: 2.5rem 1rem;
    text-align: center;
    color: white;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .flash-sale-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.03;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E");
  }

  .flash-sale-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 1024px) {
    .flash-sale-content {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .flash-sale-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    min-width: fit-content;
  }

  .flash-sale-header h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin: 0;
    line-height: 1.2;
  }

  .lightning-icon {
    font-size: 1.5rem;
    animation: flash-bolt 2s ease-in-out infinite;
  }

  @keyframes flash-bolt {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(10deg); }
    75% { transform: rotate(-10deg); }
  }

  .countdown-timer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    padding: 1rem 2rem;
    border-radius: 1.875rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.05);
    font-family: 'Inter', sans-serif;
  }

  .countdown-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 50px;
  }

  .countdown-number {
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    min-height: 2.5rem;
  }

  .countdown-label {
    font-size: 0.625rem;
    color: #C4A35A;
    font-weight: 500;
    letter-spacing: 0.15em;
    margin-top: 0.25rem;
  }

  .countdown-separator {
    color: rgba(255, 255, 255, 0.2);
    font-size: 1.875rem;
    font-weight: 300;
    padding-bottom: 1rem;
    margin: 0 0.25rem;
  }

  .flash-sale-cta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    min-width: fit-content;
  }

  .sale-discount {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #C4A35A;
    text-align: center;
    word-break: break-word;
  }

  .shop-sale-btn {
    background-color: white;
    color: #1A1A1A;
    border: none;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
    text-decoration: none;
    display: inline-block;
    font-family: 'Inter', sans-serif;
  }

  .shop-sale-btn:hover {
    background-color: #F5F5F5;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(255, 255, 255, 0.15);
  }

  .shop-sale-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .flash-sale-banner {
      margin: 2.5rem 0.5rem;
      padding: 1.5rem 1rem;
    }

    .flash-sale-content {
      gap: 1rem;
    }

    .countdown-timer {
      padding: 0.75rem 1rem;
      gap: 0.25rem;
    }

    .countdown-item {
      min-width: 40px;
    }

    .countdown-number {
      font-size: 1.25rem;
      min-height: 1.5rem;
    }

    .sale-discount {
      font-size: 1rem;
    }
  }
</style>

<div class="flash-sale-banner">
  <div class="flash-sale-content">
    {% comment %} Header with lightning bolt {% endcomment %}
    <div class="flash-sale-header">
      <span class="lightning-icon" aria-label="Flash sale lightning bolt">⚡</span>
      <h3>Summer Flash Sale</h3>
    </div>

    {% comment %} Countdown Timer {% endcomment %}
    <div class="countdown-timer" id="countdown-timer" data-end-date="{{ section.settings.sale_end_date }}">
      <div class="countdown-item">
        <span class="countdown-number" id="hours">{{ 'product.countdown.hours' | default: 'HH' }}</span>
        <span class="countdown-label">HRS</span>
      </div>
      <span class="countdown-separator">:</span>
      <div class="countdown-item">
        <span class="countdown-number" id="minutes">{{ 'product.countdown.minutes' | default: 'MM' }}</span>
        <span class="countdown-label">MIN</span>
      </div>
      <span class="countdown-separator">:</span>
      <div class="countdown-item">
        <span class="countdown-number" id="seconds">{{ 'product.countdown.seconds' | default: 'SS' }}</span>
        <span class="countdown-label">SEC</span>
      </div>
    </div>

    {% comment %} CTA and Discount {% endcomment %}
    <div class="flash-sale-cta">
      <span class="sale-discount">UP TO {{ section.settings.discount_percentage }}% OFF</span>
      <a href="{{ section.settings.sale_collection_link }}" class="shop-sale-btn">
        SHOP SALE
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    'use strict';

    function updateCountdown() {
      const timerEl = document.getElementById('countdown-timer');
      if (!timerEl) return;

      // Set default end date to 24 hours from now if not specified
      const endDateStr = timerEl.dataset.endDate || new Date(Date.now() + 86400000).toISOString();
      const endDate = new Date(endDateStr).getTime();
      const now = new Date().getTime();
      const distance = endDate - now;

      if (distance <= 0) {
        // Sale has ended
        document.getElementById('hours').textContent = '00';
        document.getElementById('minutes').textContent = '00';
        document.getElementById('seconds').textContent = '00';
        return;
      }

      // Calculate time units with zero-padding
      const hours = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
      const minutes = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
      const seconds = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');

      document.getElementById('hours').textContent = hours;
      document.getElementById('minutes').textContent = minutes;
      document.getElementById('seconds').textContent = seconds;
    }

    // Update immediately and then every second
    updateCountdown();
    setInterval(updateCountdown, 1000);
  })();
</script>

{% schema %}
{
  "name": "Flash Sale Banner",
  "settings": [
    {
      "type": "text",
      "id": "sale_end_date",
      "label": "Sale End Date/Time (ISO 8601 format)",
      "default": "2025-08-31T23:59:59Z",
      "info": "Example: 2025-08-31T23:59:59Z"
    },
    {
      "type": "text",
      "id": "discount_percentage",
      "label": "Discount Percentage",
      "default": "40"
    },
    {
      "type": "url",
      "id": "sale_collection_link",
      "label": "Sale Collection Link"
    }
  ],
  "presets": [
    {
      "name": "Flash Sale Banner",
      "settings": {
        "sale_end_date": "2025-08-31T23:59:59Z",
        "discount_percentage": "40",
        "sale_collection_link": "/collections/sale"
      }
    }
  ]
}
{% endschema %}

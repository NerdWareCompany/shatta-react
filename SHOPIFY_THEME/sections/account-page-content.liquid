{% comment %}
  SHATTA Account Page Content
{% endcomment %}

<style>
  .account-page {
    background: #FFFFFF;
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .account-page .account-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.5);
    margin-bottom: 1.5rem;
  }

  .account-page .account-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .account-page .account-breadcrumb a:hover {
    color: #1A1A1A;
  }

  .account-page .account-breadcrumb strong {
    color: #C4A35A;
    font-weight: 600;
  }

  .account-page .account-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .account-page h1 {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.1;
    color: #1A1A1A;
  }

  .account-page .logout-link,
  .account-page .account-login-btn {
    border: 1px solid #E8E0D4;
    color: #1A1A1A;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    border-radius: 9999px;
    padding: 0.65rem 1rem;
  }

  .account-page .logout-link:hover,
  .account-page .account-login-btn:hover {
    border-color: #C4A35A;
    color: #C4A35A;
  }

  .account-page .account-empty {
    border: 1px solid #E8E0D4;
    border-radius: 1.5rem;
    padding: 2rem;
    background: #FAFAFA;
    text-align: center;
  }

  .account-page .account-empty p {
    margin: 0 0 1rem;
    color: rgba(26, 26, 26, 0.7);
  }

  .account-page .account-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .account-page .account-tab {
    border: 1px solid #E8E0D4;
    background: #FFFFFF;
    color: #1A1A1A;
    border-radius: 9999px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
    padding: 0.6rem 1rem;
  }

  .account-page .account-tab[aria-selected='true'] {
    background: #1A1A1A;
    color: #FFFFFF;
    border-color: #1A1A1A;
  }

  .account-page .account-panel {
    display: none;
    border: 1px solid #E8E0D4;
    border-radius: 1.25rem;
    background: #FFFFFF;
    padding: 1rem;
  }

  .account-page .account-panel.is-active {
    display: block;
  }

  .account-page .account-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .account-page .box {
    border: 1px solid #E8E0D4;
    border-radius: 1rem;
    background: #FAFAFA;
    padding: 1rem;
  }

  .account-page .box h3,
  .account-page .account-panel h2 {
    margin: 0 0 0.75rem;
    color: #1A1A1A;
    font-family: 'Cormorant Garamond', serif;
  }

  .account-page .box p,
  .account-page .account-panel p {
    margin: 0.3rem 0;
    color: rgba(26, 26, 26, 0.75);
    line-height: 1.6;
    font-size: 0.92rem;
  }

  .account-page .orders-table-wrap {
    overflow-x: auto;
  }

  .account-page table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  .account-page th,
  .account-page td {
    text-align: left;
    border-bottom: 1px solid #E8E0D4;
    padding: 0.8rem;
    font-size: 0.87rem;
  }

  .account-page th {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: rgba(26, 26, 26, 0.6);
  }

  .account-page .badge {
    display: inline-block;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
  }

  .account-page .badge-delivered {
    background: rgba(34, 197, 94, 0.12);
    color: #0f7a2d;
  }

  .account-page .badge-processing {
    background: rgba(196, 163, 90, 0.14);
    color: #926f2c;
  }

  .account-page .address-card {
    border: 1px solid #E8E0D4;
    border-radius: 0.9rem;
    background: #FFFFFF;
    padding: 0.95rem;
  }

  .account-page .address-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .account-page .address-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C4A35A;
    font-weight: 700;
  }

  .account-page .address-default {
    font-size: 0.66rem;
    border-radius: 9999px;
    background: #C4A35A;
    color: #FFFFFF;
    padding: 0.22rem 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .account-page .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.8rem;
  }

  .account-page .wishlist-item {
    border: 1px solid #E8E0D4;
    border-radius: 0.9rem;
    overflow: hidden;
    background: #FFFFFF;
  }

  .account-page .wishlist-item img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .account-page .wishlist-item .meta {
    padding: 0.75rem;
  }

  .account-page .wishlist-item h4 {
    margin: 0;
    font-size: 0.95rem;
    color: #1A1A1A;
    font-family: 'Cormorant Garamond', serif;
  }

  .account-page .wishlist-item p {
    margin: 0.35rem 0 0;
    color: #C4A35A;
    font-weight: 600;
    font-size: 0.84rem;
  }

  @media (min-width: 768px) {
    .account-page {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .account-page .account-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .account-page .account-panel {
      padding: 1.25rem;
    }
  }
</style>

<section class="account-page" aria-label="Customer account page">
  <nav class="account-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <strong>My Account</strong>
  </nav>

  {% if customer %}
    <div class="account-header">
      <h1>My Account</h1>
      <a href="{{ routes.account_logout_url }}" class="logout-link" aria-label="Sign out">SIGN OUT</a>
    </div>

    <div class="account-tabs" role="tablist" aria-label="Account sections">
      <button class="account-tab" role="tab" type="button" aria-selected="true" aria-controls="tab-orders" id="tab-btn-orders">Orders</button>
      <button class="account-tab" role="tab" type="button" aria-selected="false" aria-controls="tab-addresses" id="tab-btn-addresses">Addresses</button>
      <button class="account-tab" role="tab" type="button" aria-selected="false" aria-controls="tab-details" id="tab-btn-details">Details</button>
      <button class="account-tab" role="tab" type="button" aria-selected="false" aria-controls="tab-wishlist" id="tab-btn-wishlist">Wishlist</button>
    </div>

    <section class="account-panel is-active" id="tab-orders" role="tabpanel" aria-labelledby="tab-btn-orders">
      <h2>Order History</h2>
      {% if customer.orders_count > 0 %}
        <div class="orders-table-wrap">
          <table aria-label="Order history table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders limit: 6 %}
                <tr>
                  <td>#{{ order.order_number }}</td>
                  <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
                  <td>
                    {% if order.fulfillment_status == 'fulfilled' %}
                      <span class="badge badge-delivered">Delivered</span>
                    {% else %}
                      <span class="badge badge-processing">Processing</span>
                    {% endif %}
                  </td>
                  <td>{{ order.total_price | money }}</td>
                  <td><a href="{{ order.customer_url }}" aria-label="View order {{ order.order_number }}">View</a></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p>No orders yet. Start shopping to see your orders here.</p>
      {% endif %}
    </section>

    <section class="account-panel" id="tab-addresses" role="tabpanel" aria-labelledby="tab-btn-addresses">
      <h2>Saved Addresses</h2>
      {% if customer.addresses_count > 0 %}
        <div class="account-grid">
          {% for address in customer.addresses %}
            <article class="address-card">
              <div class="address-top">
                <span class="address-label">Address {{ forloop.index }}</span>
                {% if address == customer.default_address %}<span class="address-default">Default</span>{% endif %}
              </div>
              <p>{{ address.first_name }} {{ address.last_name }}</p>
              <p>{{ address.street }}</p>
              {% if address.street2 != blank %}<p>{{ address.street2 }}</p>{% endif %}
              <p>{{ address.city }}, {{ address.province }} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {% if address.phone != blank %}<p>{{ address.phone }}</p>{% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <p>No saved addresses yet.</p>
      {% endif %}
      <p><a href="/account/addresses" aria-label="Manage your addresses">Manage addresses</a></p>
    </section>

    <section class="account-panel" id="tab-details" role="tabpanel" aria-labelledby="tab-btn-details">
      <h2>Account Details</h2>
      <div class="account-grid">
        <div class="box">
          <h3>Profile</h3>
          <p>Name: {{ customer.first_name }} {{ customer.last_name }}</p>
          <p>Email: {{ customer.email }}</p>
          <p>Phone: {{ customer.phone | default: 'Not provided' }}</p>
          <p>Member since: {{ customer.created_at | date: "%B %Y" }}</p>
        </div>
        <div class="box">
          <h3>Account Summary</h3>
          <p>Total orders: {{ customer.orders_count }}</p>
          <p>Total spent: {{ customer.total_spent | money }}</p>
          <p><a href="/account" aria-label="Open account settings">Go to account settings</a></p>
        </div>
      </div>
    </section>

    <section class="account-panel" id="tab-wishlist" role="tabpanel" aria-labelledby="tab-btn-wishlist">
      <h2>Wishlist</h2>
      <p>Wishlist is a preview block. Wire this to your wishlist app data source if needed.</p>
      <div class="wishlist-grid" aria-label="Wishlist preview">
        <article class="wishlist-item">
          <img src="https://api.shatta.com/storage/3274/pouf-60-(1).jpg" alt="Signature Sateen Duvet Cover" loading="lazy">
          <div class="meta">
            <h4>Signature Sateen Duvet Cover</h4>
            <p>EGP 3,450</p>
          </div>
        </article>
        <article class="wishlist-item">
          <img src="https://api.shatta.com/storage/3245/pouf-146.jpg" alt="Hotel Collection Sheets" loading="lazy">
          <div class="meta">
            <h4>Hotel Collection Sheets</h4>
            <p>EGP 4,200</p>
          </div>
        </article>
      </div>
    </section>
  {% else %}
    <div class="account-empty" role="status">
      <h1>My Account</h1>
      <p>Please sign in to view your orders, addresses, and account details.</p>
      <a class="account-login-btn" href="{{ routes.account_login_url }}" aria-label="Sign in to your account">SIGN IN</a>
    </div>
  {% endif %}
</section>

<script>
  (function() {
    const tabs = document.querySelectorAll('.account-page .account-tab');
    const panels = document.querySelectorAll('.account-page .account-panel');

    function activateTab(tab) {
      tabs.forEach((btn) => {
        btn.setAttribute('aria-selected', btn === tab ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('is-active', panel.id === tab.getAttribute('aria-controls'));
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
          event.preventDefault();
          const list = Array.from(tabs);
          const index = list.indexOf(tab);
          const offset = event.key === 'ArrowRight' ? 1 : -1;
          const next = list[(index + offset + list.length) % list.length];
          next.focus();
          activateTab(next);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Account Page Content",
  "settings": []
}
{% endschema %}

{% comment %}
  SHATTA About Page Content
{% endcomment %}

<style>
  .about-page {
    background: #FFFFFF;
  }

  .about-page .about-hero-wrap {
    padding: 0.5rem 1rem 1.5rem;
  }

  .about-page .about-hero {
    position: relative;
    height: 60vh;
    border-radius: 2.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .about-page .about-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 15s ease-out;
  }

  .about-page .about-hero:hover img {
    transform: scale(1.05);
  }

  .about-page .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.35) 40%, transparent);
  }

  .about-page .about-hero-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    color: #FFFFFF;
    padding: 3rem 2rem;
    max-width: 68rem;
  }

  .about-page .about-hero-kicker {
    display: block;
    color: #C4A35A;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .about-page .about-hero-title {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
  }

  .about-page .about-story,
  .about-page .about-values,
  .about-page .about-stats {
    padding: 4rem 1rem;
  }

  .about-page .about-story-grid {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .about-page .about-story-photo {
    border-radius: 2.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    aspect-ratio: 4 / 5;
  }

  .about-page .about-story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 15s ease-out;
  }

  .about-page .about-story-photo:hover img {
    transform: scale(1.05);
  }

  .about-page .about-story-title {
    margin: 0 0 1rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
    color: #1A1A1A;
  }

  .about-page .about-story-title em {
    color: #C4A35A;
    font-style: italic;
  }

  .about-page .about-story p {
    color: rgba(26, 26, 26, 0.72);
    line-height: 1.75;
    font-weight: 300;
    margin: 0 0 1rem;
  }

  .about-page .about-founder {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #E8E0D4;
  }

  .about-page .about-founder strong {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    color: #1A1A1A;
  }

  .about-page .about-founder span {
    font-size: 0.75rem;
    color: #C4A35A;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .about-page .about-values {
    background: #FAFAFA;
  }

  .about-page .about-values-wrap {
    max-width: 80rem;
    margin: 0 auto;
  }

  .about-page .about-values-head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .about-page .about-values-kicker {
    color: #C4A35A;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .about-page .about-values-head h2 {
    margin: 0.75rem 0 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: #1A1A1A;
  }

  .about-page .about-values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .about-page .about-value-card {
    background: #FFFFFF;
    border: 1px solid #E8E0D4;
    border-radius: 1.5rem;
    padding: 1.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .about-page .about-value-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.08);
  }

  .about-page .about-value-card h3 {
    margin: 0 0 0.5rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.45rem;
    color: #1A1A1A;
  }

  .about-page .about-value-card p {
    margin: 0;
    color: rgba(26, 26, 26, 0.65);
    line-height: 1.6;
    font-size: 0.925rem;
  }

  .about-page .about-stats {
    background: #1A1A1A;
  }

  .about-page .about-stats-wrap {
    max-width: 80rem;
    margin: 0 auto;
    color: #FFFFFF;
    text-align: center;
  }

  .about-page .about-stats-wrap h2 {
    margin: 0 0 2rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .about-page .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
  }

  .about-page .about-stat-num {
    font-family: 'Cormorant Garamond', serif;
    color: #C4A35A;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1;
    font-weight: 700;
  }

  .about-page .about-stat-label {
    margin-top: 0.45rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .about-page .about-hero-wrap,
    .about-page .about-story,
    .about-page .about-values,
    .about-page .about-stats {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .about-page .about-story-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .about-page .about-hero-content {
      padding: 4rem 3rem;
    }
  }
</style>

<section class="about-page" aria-label="About SHATTA">
  <div class="about-hero-wrap">
    <div class="about-hero">
      <img src="{{ section.settings.hero_image | image_url: width: 2200 }}" alt="{{ section.settings.hero_alt | escape }}" loading="lazy">
      <div class="about-hero-overlay"></div>
      <div class="about-hero-content">
        <span class="about-hero-kicker">Our Heritage</span>
        <h1 class="about-hero-title">Since 1988, We've Been<br>Weaving Egyptian Homes</h1>
      </div>
    </div>
  </div>

  <div class="about-story">
    <div class="about-story-grid">
      <div class="about-story-photo">
        <img src="{{ section.settings.story_image | image_url: width: 1400 }}" alt="{{ section.settings.story_alt | escape }}" loading="lazy">
      </div>
      <div>
        <h2 class="about-story-title">A Legacy of <em>Modern Luxury</em></h2>
        <p>Founded in 1988, SHATTA began as a small boutique in Cairo with one mission: bring authentic Egyptian craftsmanship into modern homes with uncompromising quality.</p>
        <p>As a family business across generations, we believe comfort and elegance live in the details, from long-staple cotton to artisan weaving traditions.</p>
        <p>With 25+ branches across Egypt, SHATTA continues to transform everyday spaces into refined sanctuaries.</p>
        <div class="about-founder">
          <strong>Youssef Shatta</strong>
          <span>Founder & Chairman</span>
        </div>
      </div>
    </div>
  </div>

  <div class="about-values">
    <div class="about-values-wrap">
      <div class="about-values-head">
        <span class="about-values-kicker">What Defines Us</span>
        <h2>Our Core Values</h2>
      </div>
      <div class="about-values-grid">
        <article class="about-value-card">
          <h3>Craftsmanship</h3>
          <p>Meticulous attention to detail passed down through generations of artisans.</p>
        </article>
        <article class="about-value-card">
          <h3>Heritage</h3>
          <p>Rooted in Egypt's rich textile history and traditions since 1988.</p>
        </article>
        <article class="about-value-card">
          <h3>Sustainability</h3>
          <p>Committed to responsible sourcing and practices for a better tomorrow.</p>
        </article>
        <article class="about-value-card">
          <h3>Community</h3>
          <p>Supporting homes, families, and the people behind each handcrafted piece.</p>
        </article>
      </div>
    </div>
  </div>

  <div class="about-stats">
    <div class="about-stats-wrap">
      <h2>By The Numbers</h2>
      <div class="about-stats-grid">
        <div>
          <div class="about-stat-num" data-countup="35">35+</div>
          <div class="about-stat-label">Years</div>
        </div>
        <div>
          <div class="about-stat-num" data-countup="25">25+</div>
          <div class="about-stat-label">Branches</div>
        </div>
        <div>
          <div class="about-stat-num" data-countup="1000000">1M+</div>
          <div class="about-stat-label">Happy Homes</div>
        </div>
        <div>
          <div class="about-stat-num" data-countup="500">500+</div>
          <div class="about-stat-label">Artisans</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const statNodes = document.querySelectorAll('.about-page [data-countup]');
    if (!statNodes.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const node = entry.target;
        const target = parseInt(node.getAttribute('data-countup') || '0', 10);
        const duration = 1600;
        const start = performance.now();

        function animate(now) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          const value = Math.floor(target * eased);
          if (target >= 1000000) {
            node.textContent = Math.max(1, Math.floor(value / 1000000)) + 'M+';
          } else {
            node.textContent = value + '+';
          }
          if (progress < 1) requestAnimationFrame(animate);
        }

        requestAnimationFrame(animate);
        observer.unobserve(node);
      });
    }, { threshold: 0.35 });

    statNodes.forEach((node) => observer.observe(node));
  })();
</script>

{% schema %}
{
  "name": "About Page Content",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Hero image alt text",
      "default": "SHATTA heritage"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "story_alt",
      "label": "Story image alt text",
      "default": "SHATTA artisans"
    }
  ]
}
{% endschema %}

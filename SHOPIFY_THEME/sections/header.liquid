{% comment %}
  SHATTA Header Section
  Includes: Announcement bar, navigation, search, cart, mobile menu
  Pixel-perfect recreation of React component
{% endcomment %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Free Shipping on Orders Over EGP 3,000 · 25+ Branches Across Egypt · Est. 1988"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .announcement-bar {
    background: #C4A35A;
    color: #FFFFFF;
    min-height: 2.75rem;
    padding: 0.625rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 1rem;
  }

  .announcement-left,
  .announcement-center,
  .announcement-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .announcement-left {
    gap: 0.5rem;
    justify-content: flex-start;
  }

  .announcement-center {
    justify-content: center;
    text-align: center;
  }

  .announcement-right {
    justify-content: flex-end;
  }

  .announcement-bar a,
  .announcement-language {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  .announcement-language {
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .announcement-bar a:hover,
  .announcement-language:hover {
    opacity: 0.8;
  }

  .announcement-divider {
    opacity: 0.6;
  }

  .shatta-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
  }

  .shatta-header.is-scrolled {
    top: 1rem;
    padding: 0 1rem;
  }

  .header-shell {
    width: 100%;
    background: #FFFFFF;
    border-bottom: 1px solid #E8E0D4;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shatta-header.is-scrolled .header-shell {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .header-main {
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shatta-header.is-scrolled .header-main {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .header-left,
  .header-center,
  .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header-left {
    gap: 1rem;
  }

  .header-center {
    justify-content: center;
    text-decoration: none;
    color: #1A1A1A;
  }

  .header-right {
    justify-content: flex-end;
    color: #1A1A1A;
    gap: 1rem;
  }

  .header-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: scale(1);
    transition: transform 0.5s;
  }

  .header-center:hover .header-logo {
    transform: scale(1.05);
  }

  .logo-text {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
    color: #1A1A1A;
  }

  .logo-subtitle {
    margin-top: 0.25rem;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #C4A35A;
    transition: opacity 0.3s;
    opacity: 1;
  }

  .shatta-header.is-scrolled .logo-subtitle {
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .menu-btn {
    display: none;
    border: 0;
    background: transparent;
    color: #1A1A1A;
    cursor: pointer;
    padding: 0;
    line-height: 0;
    transition: color 0.3s;
  }

  .menu-btn:hover {
    color: #C4A35A;
  }

  .header-search-trigger {
    display: flex;
    align-items: center;
    color: rgba(26, 26, 26, 0.6);
    transition: color 0.3s;
    cursor: pointer;
  }

  .header-search-trigger:hover {
    color: #1A1A1A;
  }

  .header-search-trigger svg {
    width: 1rem;
    height: 1rem;
    margin-right: 0.5rem;
  }

  .header-search-trigger span {
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1;
  }

  .header-icon-link,
  .header-icon-btn {
    color: inherit;
    text-decoration: none;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    line-height: 0;
    transition: color 0.3s;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header-icon-link:hover,
  .header-icon-btn:hover {
    color: #C4A35A;
  }

  .header-icon-link svg,
  .header-icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1.75;
  }

  .header-icon-cart {
    margin-left: 0;
  }

  .cart-badge {
    position: absolute;
    top: -0.375rem;
    right: -0.5rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: #C4A35A;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .header-nav {
    position: relative;
    overflow: hidden;
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    height: 2.5rem;
    opacity: 1;
    display: block;
  }

  .shatta-header.is-scrolled .header-nav {
    height: 0;
    opacity: 0;
  }

  .header-nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: center;
    column-gap: 2rem;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: #1A1A1A;
  }

  .header-nav-item {
    position: relative;
    padding-bottom: 0.5rem;
  }

  .header-nav-item-home {
    position: static;
  }

  .header-nav-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    transition: color 0.3s;
    cursor: pointer;
  }

  .header-nav-link:hover {
    color: #C4A35A;
  }

  .header-nav-link svg {
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 0.25rem;
  }

  .header-nav-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 999px;
    background: #C4A35A;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease-out;
  }

  [dir="rtl"] .header-nav-underline {
    transform-origin: right;
  }

  .header-nav-item:hover .header-nav-underline {
    transform: scaleX(1);
  }

  .mega-menu {
    position: absolute;
    left: 0;
    width: 100%;
    margin-top: 0.5rem;
    padding: 2rem 2rem 3rem;
    background: #FFFFFF;
    border-top: 1px solid #E8E0D4;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem);
    transition: all 0.3s;
    z-index: 50;
    text-align: left;
  }

  .header-nav-item-home:hover .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mega-menu-inner {
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    gap: 3rem;
  }

  .mega-columns {
    flex: 1;
    display: flex;
    gap: 2rem;
  }

  .mega-column {
    flex: 1;
  }

  .mega-heading {
    display: block;
    margin-bottom: 1rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.125rem;
    color: #1A1A1A;
    text-decoration: none;
  }

  .mega-heading:hover {
    color: #C4A35A;
  }

  .mega-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: #6B7280;
    text-transform: none;
  }

  .mega-list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .mega-list a:hover {
    color: #1A1A1A;
  }

  .mega-promo {
    width: 18rem;
    flex-shrink: 0;
  }

  .mega-promo-link {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .mega-promo-link img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.7s;
  }

  .mega-promo-link:hover img {
    transform: scale(1.05);
  }

  .mega-promo-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    transition: background 0.3s;
  }

  .mega-promo-link:hover .mega-promo-overlay {
    background: rgba(0, 0, 0, 0.3);
  }

  .mega-promo-title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    text-transform: none;
  }

  .mega-featured {
    width: 16rem;
    flex-shrink: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .mega-featured-title {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6B7280;
  }

  .mega-featured-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mega-featured-item {
    display: flex;
    gap: 1rem;
    text-decoration: none;
  }

  .mega-featured-image {
    width: 4rem;
    height: 4rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #F9FAFB;
    flex-shrink: 0;
  }

  .mega-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .mega-featured-item:hover .mega-featured-image img {
    transform: scale(1.05);
  }

  .mega-featured-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mega-featured-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: #1A1A1A;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s;
  }

  .mega-featured-item:hover .mega-featured-name {
    color: #C4A35A;
  }

  .mega-featured-price {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: #6B7280;
  }

  @media (max-width: 1023px) {
    .header-right {
      gap: 0.75rem;
    }
  }

  @media (max-width: 767px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .header-nav {
      display: none;
    }

    .logo-text {
      font-size: 1.875rem;
    }
  }

  @media (max-width: 639px) {
    .announcement-center {
      display: none;
    }

    .header-search-trigger,
    .account-link {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .shatta-header.is-scrolled {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .menu-btn {
      display: none;
    }

    .logo-text {
      font-size: 2.25rem;
    }

    .header-right {
      gap: 1.5rem;
    }
  }
</style>

<!-- Announcement Bar -->
{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    <div class="announcement-left">
      <a href="{{ routes.account_login_url }}">Login</a>
      <span class="announcement-divider">|</span>
      <a href="{{ routes.account_register_url }}">Register</a>
    </div>
    <div class="announcement-center">
      {{ section.settings.announcement_text }}
    </div>
    <div class="announcement-right">
      <button class="announcement-language" onclick="toggleLanguage()">EN | عربي</button>
    </div>
  </div>
{% endif %}

<!-- Main Header -->
<header class="shatta-header" id="header" role="banner">
  <div class="header-shell">
    <div class="header-main">
    <!-- Left: Menu & Search -->
    <div class="header-left">
      <button class="menu-btn" id="mobile-menu-btn" onclick="openMobileMenu()" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 5h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 19h16"></path>
        </svg>
      </button>
      <div class="header-search-trigger" onclick="openSearch()" role="search" aria-label="Search products">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span>Search products...</span>
      </div>
    </div>

    <!-- Center: Logo -->
    <a href="/" class="header-center" aria-label="SHATTA Home">
      <div class="header-logo">
        <h1 class="logo-text">SHATTA</h1>
        <span class="logo-subtitle">ESTD.1988</span>
      </div>
    </a>

    <!-- Right: Account, Wishlist, Cart -->
    <div class="header-right">
      <a href="{{ routes.account_url }}" class="header-icon-link account-link" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      
      <button class="header-icon-btn" onclick="toggleWishlist()" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
        </svg>
      </button>
      
      <button class="header-icon-btn header-icon-cart" id="cart-btn" onclick="openCart()" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
        </svg>
        <span class="cart-badge" id="cart-count">3</span>
      </button>
    </div>
  </div>
  
  <!-- Desktop Navigation -->
  <nav class="header-nav" aria-label="Main navigation">
    <ul class="header-nav-list">
      <li class="header-nav-item header-nav-item-home">
        <a href="/collections/all" class="header-nav-link">
          HOME DECOR
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <span class="header-nav-underline"></span>
        <div class="mega-menu" aria-hidden="true">
          <div class="mega-menu-inner">
            <div class="mega-columns">
              <div class="mega-column">
                <a href="/collections/all" class="mega-heading">Living Room</a>
                <ul class="mega-list">
                  <li><a href="/collections/all">Sofas &amp; Sectionals</a></li>
                  <li><a href="/collections/all">Coffee Tables</a></li>
                  <li><a href="/collections/all">TV Units</a></li>
                  <li><a href="/collections/all">Rugs &amp; Carpets</a></li>
                </ul>
              </div>
              <div class="mega-column">
                <a href="/collections/all" class="mega-heading">Bedroom</a>
                <ul class="mega-list">
                  <li><a href="/collections/all">Beds &amp; Headboards</a></li>
                  <li><a href="/collections/all">Nightstands</a></li>
                  <li><a href="/collections/all">Dressers</a></li>
                  <li><a href="/collections/all">Wardrobes</a></li>
                </ul>
              </div>
            </div>

            <div class="mega-promo">
              <a href="/collections/all" class="mega-promo-link">
                <img src="https://api.shatta.com/storage/4448/lehaf_098.jpg" alt="New collection" loading="lazy" />
                <span class="mega-promo-overlay"></span>
                <span class="mega-promo-title">New Collection</span>
              </a>
            </div>

            <div class="mega-featured">
              <h4 class="mega-featured-title">Featured</h4>
              <div class="mega-featured-list">
                <a href="/products" class="mega-featured-item">
                  <span class="mega-featured-image">
                    <img src="https://api.shatta.com/storage/3235/pouf-157_L.jpg" alt="Velvet Accent Cushion" loading="lazy" />
                  </span>
                  <span class="mega-featured-copy">
                    <span class="mega-featured-name">Velvet Accent Cushion</span>
                    <span class="mega-featured-price">EGP 850</span>
                  </span>
                </a>
                <a href="/products" class="mega-featured-item">
                  <span class="mega-featured-image">
                    <img src="https://api.shatta.com/storage/4448/lehaf_098.jpg" alt="Ceramic Table Lamp" loading="lazy" />
                  </span>
                  <span class="mega-featured-copy">
                    <span class="mega-featured-name">Ceramic Table Lamp</span>
                    <span class="mega-featured-price">EGP 2,100</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </li>
      <li class="header-nav-item"><a href="/collections/bed-bath" class="header-nav-link">BED &amp; BATH</a><span class="header-nav-underline"></span></li>
      <li class="header-nav-item"><a href="/collections/curtains" class="header-nav-link">CURTAINS</a><span class="header-nav-underline"></span></li>
      <li class="header-nav-item"><a href="/collections/beach" class="header-nav-link">BEACH</a><span class="header-nav-underline"></span></li>
      <li class="header-nav-item"><a href="/collections/bridal" class="header-nav-link">BRIDAL</a><span class="header-nav-underline"></span></li>
      <li class="header-nav-item"><a href="/collections/corporate" class="header-nav-link">CORPORATE</a><span class="header-nav-underline"></span></li>
      <li class="header-nav-item"><a href="#" class="header-nav-link">BRANCHES</a><span class="header-nav-underline"></span></li>
    </ul>
  </nav>
  </div>
</header>


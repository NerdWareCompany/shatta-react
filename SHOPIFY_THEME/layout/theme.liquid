<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  
  <title>
    {%- if page_title -%}
      {{ page_title }} | {{ shop.name }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>
  
  <meta name="description" content="{{ page_description | escape }}">
  
  {%- if canonical_url -%}
    <link rel="canonical" href="{{ canonical_url }}">
  {%- endif -%}
  
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <!-- Core Styles -->
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  
  {%- if request.design_mode -%}
    <style>
      .shopify-section { background-color: rgba(0, 0, 0, 0.02); border: 1px dashed rgba(0, 0, 0, 0.1); }
      .shopify-section > * { margin-bottom: 0; }
    </style>
  {%- endif -%}
  
  {{ content_for_header }}
</head>

<body class="font-sans text-[#1A1A1A] bg-white antialiased">
  
  {% section 'header' %}
  
  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>
  
  {% section 'footer' %}
  
  <style>
    .shatta-overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
    }

    .shatta-overlay-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
    }

    .shatta-drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(100%, 420px);
      height: 100%;
      background: #FFFFFF;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      transform: translateX(0);
      animation: shattaSlideInRight 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .shatta-drawer-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid #F0F0F0;
    }

    .shatta-drawer-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.75rem;
      color: #1A1A1A;
      margin: 0;
    }

    .shatta-title-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.2rem;
      height: 1.2rem;
      margin-left: 0.5rem;
      padding: 0 0.35rem;
      border-radius: 9999px;
      background: #F3F3F3;
      color: #6A6A6A;
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .shatta-icon-btn {
      width: 2rem;
      height: 2rem;
      border: 0;
      border-radius: 9999px;
      background: transparent;
      color: #7A7A7A;
      cursor: pointer;
      font-size: 1.25rem;
    }

    .shatta-icon-btn:hover {
      color: #1A1A1A;
      background: #F8F8F8;
    }

    .shatta-panel-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem 1.5rem;
    }

    .shatta-cart-msg {
      font-size: 0.9rem;
      color: #5F5F5F;
      margin-bottom: 0.75rem;
    }

    .shatta-progress {
      width: 100%;
      height: 6px;
      background: #E8E0D4;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 1.25rem;
    }

    .shatta-progress > span {
      display: block;
      width: 80%;
      height: 100%;
      background: #1A1A1A;
      transition: width 0.5s ease-out;
    }

    .shatta-cart-foot {
      border-top: 1px solid #F0F0F0;
      background: #F9F9F9;
      padding: 1.25rem 1.5rem;
    }

    .shatta-cart-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      color: #1A1A1A;
    }

    .shatta-checkout-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 3rem;
      border-radius: 0.75rem;
      border: 0;
      background: #1A1A1A;
      color: #FFFFFF;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-decoration: none;
    }

    .shatta-checkout-btn:hover {
      background: #C4A35A;
    }

    .shatta-view-cart-link {
      display: block;
      margin-top: 0.85rem;
      text-align: center;
      color: #6B6B6B;
      font-size: 0.85rem;
      text-decoration: underline;
    }

    .shatta-view-cart-link:hover {
      color: #1A1A1A;
    }

    .shatta-mobile-drawer {
      position: absolute;
      left: 0;
      top: 0;
      width: min(85%, 320px);
      height: 100%;
      background: #FFFFFF;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
      animation: shattaSlideInLeft 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .shatta-mobile-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
    }

    .shatta-mobile-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
      border-bottom: 1px solid #F3F4F6;
      flex-shrink: 0;
    }

    .shatta-mobile-title {
      margin: 0;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #1A1A1A;
    }

    .shatta-mobile-close {
      border: 0;
      border-radius: 9999px;
      background: transparent;
      color: #9CA3AF;
      width: 2.5rem;
      height: 2.5rem;
      margin-right: -0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s;
    }

    .shatta-mobile-close:hover {
      color: #111111;
      background: #F9FAFB;
    }

    .shatta-mobile-body {
      flex: 1;
      overflow-y: auto;
      padding: 1rem 0;
    }

    .shatta-mobile-links {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .shatta-mobile-links > li {
      border-bottom: 1px solid #F9FAFB;
    }

    .shatta-mobile-link,
    .shatta-mobile-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      color: #1A1A1A;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      list-style: none;
    }

    .shatta-mobile-summary::-webkit-details-marker {
      display: none;
    }

    .shatta-mobile-chevron-wrap {
      width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      background: #F9FAFB;
      color: #9CA3AF;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s;
    }

    details[open] .shatta-mobile-chevron-wrap {
      transform: rotate(180deg);
    }

    .shatta-mobile-submenu {
      padding: 0 1.5rem 1rem;
    }

    .shatta-mobile-subgroup {
      border-left: 2px solid #F3F4F6;
      margin-left: 0.5rem;
      padding-left: 1rem;
      padding-top: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .shatta-mobile-subtitle {
      font-size: 1rem;
      color: #4B5563;
      text-decoration: none;
      font-weight: 500;
    }

    .shatta-mobile-sublinks {
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0 0 0 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .shatta-mobile-sublinks a {
      color: #6B7280;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 400;
    }

    .shatta-mobile-promo {
      margin-top: 1.5rem;
      border-radius: 0.75rem;
      overflow: hidden;
      position: relative;
      display: block;
    }

    .shatta-mobile-promo img {
      width: 100%;
      height: 8rem;
      object-fit: cover;
      display: block;
    }

    .shatta-mobile-promo span {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-family: 'Cormorant Garamond', serif;
      letter-spacing: 0.05em;
      background: rgba(0, 0, 0, 0.2);
    }

    .shatta-mobile-footer {
      border-top: 1px solid #F3F4F6;
      background: #F9FAFB;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      flex-shrink: 0;
    }

    .shatta-mobile-search-btn {
      width: 100%;
      min-height: 3rem;
      border: 1px solid #E5E7EB;
      background: #FFFFFF;
      color: #1A1A1A;
      border-radius: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    .shatta-mobile-auth {
      border-top: 1px solid rgba(229, 231, 235, 0.6);
      padding-top: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.75rem;
    }

    .shatta-mobile-auth-left,
    .shatta-mobile-auth-right {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .shatta-mobile-auth a,
    .shatta-mobile-auth button {
      border: 0;
      background: transparent;
      color: #1A1A1A;
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
      padding: 0;
      transition: color 0.3s;
    }

    .shatta-mobile-auth a:hover,
    .shatta-mobile-auth button:hover {
      color: #C4A35A;
    }

    .shatta-mobile-auth-sep {
      color: #D1D5DB;
    }

    .shatta-search-panel {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
    }

    .shatta-search-panel .shatta-overlay-backdrop {
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
    }

    .shatta-search-shell {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      background: #FFFFFF;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      max-height: 100vh;
      display: flex;
      flex-direction: column;
      animation: shattaDropIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .shatta-search-inner {
      max-width: 64rem;
      margin: 0 auto;
      width: 100%;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
    }

    .shatta-search-row {
      display: flex;
      align-items: center;
      border-bottom: 1px solid #F3F4F6;
      padding: 1rem 0;
      flex-shrink: 0;
    }

    .shatta-search-input-wrap {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .shatta-search-icon {
      position: absolute;
      left: 0;
      width: 1.5rem;
      height: 1.5rem;
      color: #9CA3AF;
      pointer-events: none;
    }

    .shatta-search-input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: #1A1A1A;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.125rem;
      padding: 0.75rem 2.5rem;
      line-height: 1.2;
    }

    .shatta-search-input::placeholder {
      color: #D1D5DB;
    }

    .shatta-search-clear {
      position: absolute;
      right: 0;
      border: 0;
      background: transparent;
      color: #9CA3AF;
      width: 2rem;
      height: 2rem;
      padding: 0;
      cursor: pointer;
      transition: color 0.3s;
    }

    .shatta-search-clear:hover {
      color: #111111;
    }

    .shatta-search-close {
      margin-left: 1rem;
      margin-right: -0.5rem;
      border: 0;
      border-radius: 9999px;
      width: 2.5rem;
      height: 2.5rem;
      background: transparent;
      color: #6B7280;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s;
      flex-shrink: 0;
    }

    .shatta-search-close:hover {
      color: #111111;
      background: #F9FAFB;
    }

    .shatta-search-content {
      padding: 2rem 0;
      overflow-y: auto;
      flex: 1;
    }

    .shatta-search-state {
      display: none;
    }

    .shatta-search-state.is-active {
      display: block;
    }

    .shatta-search-heading {
      margin: 0 0 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #6B7280;
    }

    .shatta-search-chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .shatta-search-chip {
      border: 0;
      border-radius: 9999px;
      padding: 0.5rem 1rem;
      background: #F9FAFB;
      color: #1A1A1A;
      font-size: 0.875rem;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .shatta-search-chip:hover {
      background: #F3F4F6;
    }

    .shatta-search-loading {
      display: flex;
      justify-content: center;
      padding: 3rem 0;
    }

    .shatta-search-loading svg {
      width: 2rem;
      height: 2rem;
      color: #C4A35A;
      animation: spin 1s linear infinite;
    }

    .shatta-search-results-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .shatta-search-products {
      min-width: 0;
    }

    .shatta-search-products-title {
      margin: 0 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #F3F4F6;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #6B7280;
    }

    .shatta-search-products-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .shatta-search-product {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem;
      border-radius: 0.75rem;
      text-decoration: none;
      transition: background 0.3s;
    }

    .shatta-search-product:hover {
      background: #F9FAFB;
    }

    .shatta-search-product-image {
      width: 4rem;
      height: 4rem;
      flex-shrink: 0;
      border-radius: 0.5rem;
      overflow: hidden;
      background: #F3F4F6;
    }

    .shatta-search-product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }

    .shatta-search-product:hover .shatta-search-product-image img {
      transform: scale(1.05);
    }

    .shatta-search-product-name {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 500;
      color: #1A1A1A;
      transition: color 0.3s;
    }

    .shatta-search-product:hover .shatta-search-product-name {
      color: #C4A35A;
    }

    .shatta-search-product-price {
      margin: 0.25rem 0 0;
      font-size: 0.75rem;
      color: #6B7280;
    }

    .shatta-search-side {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .shatta-search-side-title {
      margin: 0 0 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #6B7280;
    }

    .shatta-search-side ul {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .shatta-search-side a {
      color: #1A1A1A;
      text-decoration: none;
      font-size: 0.875rem;
      padding: 0.25rem 0;
      transition: color 0.3s;
    }

    .shatta-search-side a:hover {
      color: #C4A35A;
    }

    .shatta-search-cta {
      padding: 1rem 0 2rem;
      border-top: 1px solid #F3F4F6;
      text-align: center;
      flex-shrink: 0;
    }

    .shatta-search-cta button {
      border: 0;
      background: transparent;
      color: #1A1A1A;
      text-decoration: underline;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: color 0.3s;
    }

    .shatta-search-cta button:hover {
      color: #C4A35A;
    }

    @media (min-width: 640px) {
      .shatta-search-products-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 768px) {
      .shatta-search-input {
        font-size: 1.5rem;
      }

      .shatta-search-row {
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
      }

      .shatta-search-results-grid {
        grid-template-columns: 2fr 1fr;
      }
    }

    @keyframes shattaSlideInRight {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }

    @keyframes shattaSlideInLeft {
      from { transform: translateX(-100%); }
      to { transform: translateX(0); }
    }

    @keyframes shattaDropIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <!-- Modals Container -->
  <div id="modals-container"></div>

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="hidden shatta-overlay" aria-hidden="true">
    <div class="shatta-overlay-backdrop" onclick="closeCart()"></div>
    <aside class="shatta-drawer" role="dialog" aria-modal="true" aria-label="Cart">
      <div class="shatta-drawer-head">
        <h2 class="shatta-drawer-title">Your Cart <span class="shatta-title-count" id="cart-title-count">0</span></h2>
        <button type="button" class="shatta-icon-btn" onclick="closeCart()" aria-label="Close cart">×</button>
      </div>
      <div class="shatta-panel-body">
        <p class="shatta-cart-msg">Only <strong>EGP 500</strong> away from <strong>FREE Shipping</strong></p>
        <div class="shatta-progress"><span></span></div>
        <p class="text-sm text-muted">Taxes and shipping calculated at checkout.</p>
      </div>
      <div class="shatta-cart-foot">
        <div class="shatta-cart-total">
          <span>Subtotal</span>
          <strong>EGP 0</strong>
        </div>
        <a href="/checkout" class="shatta-checkout-btn">CHECKOUT</a>
        <a href="{{ routes.cart_url }}" class="shatta-view-cart-link">View Cart</a>
      </div>
    </aside>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden shatta-overlay" aria-hidden="true">
    <div class="shatta-mobile-backdrop" onclick="closeMobileMenu()"></div>
    <aside class="shatta-mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile menu">
      <div class="shatta-mobile-head">
        <h2 class="shatta-mobile-title">MENU</h2>
        <button type="button" class="shatta-mobile-close" onclick="closeMobileMenu()" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <div class="shatta-mobile-body hide-scrollbar">
        <ul class="shatta-mobile-links">
          <li>
            <details class="shatta-mobile-accordion" id="mobile-home-decor">
              <summary class="shatta-mobile-summary">
                HOME DECOR
                <span class="shatta-mobile-chevron-wrap" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </span>
              </summary>
              <div class="shatta-mobile-submenu">
                <div class="shatta-mobile-subgroup">
                  <div>
                    <a href="/collections/all" class="shatta-mobile-subtitle">Living Room</a>
                    <ul class="shatta-mobile-sublinks">
                      <li><a href="/collections/all">Sofas &amp; Sectionals</a></li>
                      <li><a href="/collections/all">Coffee Tables</a></li>
                    </ul>
                  </div>
                  <div>
                    <a href="/collections/all" class="shatta-mobile-subtitle">Bedroom</a>
                    <ul class="shatta-mobile-sublinks">
                      <li><a href="/collections/all">Beds &amp; Headboards</a></li>
                      <li><a href="/collections/all">Nightstands</a></li>
                    </ul>
                  </div>
                </div>

                <a href="/collections/all" class="shatta-mobile-promo">
                  <img src="https://api.shatta.com/storage/4448/lehaf_098.jpg" alt="New Collection" loading="lazy" />
                  <span>New Collection</span>
                </a>
              </div>
            </details>
          </li>
          <li><a href="/collections/bed-bath" class="shatta-mobile-link">BED &amp; BATH</a></li>
          <li><a href="/collections/curtains" class="shatta-mobile-link">CURTAINS</a></li>
          <li><a href="/collections/beach" class="shatta-mobile-link">BEACH</a></li>
          <li><a href="/collections/bridal" class="shatta-mobile-link">BRIDAL</a></li>
          <li><a href="/collections/corporate" class="shatta-mobile-link">CORPORATE</a></li>
          <li><a href="#" class="shatta-mobile-link">BRANCHES</a></li>
        </ul>

      </div>

      <div class="shatta-mobile-footer">
        <button type="button" class="shatta-mobile-search-btn" onclick="closeMobileMenu(); openSearch();">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
          Search Products
        </button>

        <div class="shatta-mobile-auth">
          <div class="shatta-mobile-auth-left">
            <a href="{{ routes.account_login_url }}">Login</a>
            <span class="shatta-mobile-auth-sep">|</span>
            <a href="{{ routes.account_register_url }}">Register</a>
          </div>
          <div class="shatta-mobile-auth-right">
            <a href="{{ routes.account_url }}" aria-label="Account">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </a>
            <button type="button" onclick="toggleWishlist()" aria-label="Wishlist">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- Predictive Search -->
  <div id="predictive-search-panel" class="hidden shatta-search-panel" aria-hidden="true">
    <div class="shatta-overlay-backdrop" onclick="closeSearch()"></div>
    <section class="shatta-search-shell" role="dialog" aria-modal="true" aria-label="Search">
      <div class="shatta-search-inner">
        <div class="shatta-search-row">
          <div class="shatta-search-input-wrap">
            <svg class="shatta-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.34-4.34"></path>
            </svg>
            <input id="shatta-search-input" type="search" class="shatta-search-input" placeholder="Search for products, collections, pages..." aria-label="Search for products" />
            <button id="shatta-search-clear" type="button" class="shatta-search-clear hidden" aria-label="Clear search">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m15 9-6 6"></path>
                <path d="m9 9 6 6"></path>
              </svg>
            </button>
          </div>

          <button type="button" class="shatta-search-close" onclick="closeSearch()" aria-label="Close search">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>

        <div class="shatta-search-content hide-scrollbar">
          <div id="shatta-search-loading" class="shatta-search-state shatta-search-loading" aria-live="polite">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>

          <div id="shatta-search-results" class="shatta-search-state">
            <div class="shatta-search-results-grid">
              <div class="shatta-search-products">
                <h3 class="shatta-search-products-title">Products</h3>
                <div class="shatta-search-products-list">
                  <a href="#" class="shatta-search-product">
                    <span class="shatta-search-product-image"><img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&q=80&w=200" alt="Classic Velvet Sofa" loading="lazy" /></span>
                    <span>
                      <span class="shatta-search-product-name">Classic Velvet Sofa</span>
                      <span class="shatta-search-product-price">EGP 24,500</span>
                    </span>
                  </a>
                  <a href="#" class="shatta-search-product">
                    <span class="shatta-search-product-image"><img src="https://images.unsplash.com/photo-1505693314120-0d443867891c?auto=format&fit=crop&q=80&w=200" alt="Modern Lounge Chair" loading="lazy" /></span>
                    <span>
                      <span class="shatta-search-product-name">Modern Lounge Chair</span>
                      <span class="shatta-search-product-price">EGP 8,000</span>
                    </span>
                  </a>
                  <a href="#" class="shatta-search-product">
                    <span class="shatta-search-product-image"><img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=200" alt="Decorative Pillow" loading="lazy" /></span>
                    <span>
                      <span class="shatta-search-product-name">Decorative Pillow</span>
                      <span class="shatta-search-product-price">EGP 850</span>
                    </span>
                  </a>
                  <a href="#" class="shatta-search-product">
                    <span class="shatta-search-product-image"><img src="https://images.unsplash.com/photo-1519947486511-46149fa0a254?auto=format&fit=crop&q=80&w=200" alt="Ceramic Table Lamp" loading="lazy" /></span>
                    <span>
                      <span class="shatta-search-product-name">Ceramic Table Lamp</span>
                      <span class="shatta-search-product-price">EGP 2,100</span>
                    </span>
                  </a>
                </div>
              </div>

              <div class="shatta-search-side">
                <div>
                  <h3 class="shatta-search-side-title">Collections</h3>
                  <ul>
                    <li><a href="#">Living Room Sets</a></li>
                    <li><a href="#">Velvet Sofas</a></li>
                    <li><a href="#">Modern Decor</a></li>
                  </ul>
                </div>
                <div>
                  <h3 class="shatta-search-side-title">Pages</h3>
                  <ul>
                    <li><a href="#">Sofa Buying Guide</a></li>
                    <li><a href="#">Return Policy</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div id="shatta-search-popular" class="shatta-search-state is-active" aria-label="Popular searches">
            <h3 class="shatta-search-heading">Popular Searches</h3>
            <div class="shatta-search-chip-list">
              <button type="button" class="shatta-search-chip">Sofa</button>
              <button type="button" class="shatta-search-chip">Bed</button>
              <button type="button" class="shatta-search-chip">Dining Table</button>
              <button type="button" class="shatta-search-chip">Lighting</button>
              <button type="button" class="shatta-search-chip">Rugs</button>
            </div>
          </div>
        </div>

        <div id="shatta-search-cta" class="shatta-search-cta hidden">
          <button type="button">Search for "<span id="shatta-search-query"></span>"</button>
        </div>
      </div>
    </section>
  </div>
  
  <!-- Core Scripts -->
  <script src="{{ 'main.js' | asset_url }}" defer></script>
  
  {%- if request.page_type == 'product' -%}
    <script src="{{ 'product.js' | asset_url }}" defer></script>
  {%- endif -%}
  
  {%- if request.page_type == 'collection' -%}
    <script src="{{ 'collection.js' | asset_url }}" defer></script>
  {%- endif -%}
  
  {%- if request.page_type == 'cart' -%}
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  {%- endif -%}
  
</body>

</html>

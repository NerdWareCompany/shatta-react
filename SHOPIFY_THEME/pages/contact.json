{% comment %}
  SHATTA Contact Page
  Contact form, company information, map, FAQ
{% endcomment %}

<style>
  .contact-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(26, 26, 26, 0.5);
    font-weight: 300;
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .breadcrumb a:hover {
    color: #1A1A1A;
  }

  .breadcrumb-separator {
    margin: 0 0.5rem;
  }

  .breadcrumb-current {
    color: #C4A35A;
    font-weight: 500;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .page-subtitle {
    color: rgba(26, 26, 26, 0.6);
    font-weight: 300;
    max-width: 40rem;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .contact-form {
    background-color: #F9F9F9;
    border: 1px solid #E8E0D4;
    border-radius: 1.875rem;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .contact-form {
      padding: 2.5rem;
    }
  }

  .form-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(26, 26, 26, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 1rem;
    border: 1px solid #E8E0D4;
    border-radius: 0.75rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #1A1A1A;
    background-color: white;
    transition: all 0.3s;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #C4A35A;
    box-shadow: 0 0 0 1px #C4A35A;
  }

  .form-input::placeholder {
    color: rgba(26, 26, 26, 0.3);
  }

  .form-textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .submit-btn {
    width: 100%;
    padding: 1rem 2rem;
    background-color: #C4A35A;
    color: white;
    border: none;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 1rem;
  }

  .submit-btn:hover {
    background-color: #D4B97A;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(196, 163, 90, 0.3);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-card {
    background-color: white;
    border: 1px solid #E8E0D4;
    border-radius: 1.875rem;
    padding: 2rem;
  }

  .info-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: rgba(196, 163, 90, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .info-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 0.5rem;
  }

  .info-content {
    color: rgba(26, 26, 26, 0.7);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .info-content a {
    color: #C4A35A;
    text-decoration: none;
    transition: color 0.3s;
  }

  .info-content a:hover {
    color: #D4B97A;
  }

  .faq-section {
    margin-top: 4rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 2rem;
    text-align: center;
  }

  .faq-container {
    max-width: 56rem;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid #E8E0D4;
    border-radius: 1rem;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    background-color: white;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 600;
    color: #1A1A1A;
  }

  .faq-item:hover .faq-question {
    background-color: #F9F9F9;
  }

  .faq-toggle {
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
  }

  .faq-item.active .faq-toggle {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, padding 0.3s;
    padding: 0 1.5rem;
    background-color: #FAFAFA;
  }

  .faq-item.active .faq-answer {
    max-height: 500px;
    padding: 1.5rem;
  }

  .faq-answer p {
    color: rgba(26, 26, 26, 0.7);
    font-weight: 300;
    line-height: 1.6;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .contact-container {
      padding: 1rem;
    }

    .contact-form,
    .info-card {
      padding: 1.5rem;
    }

    .page-title {
      font-size: 2rem;
    }
  }
</style>

<div class="min-h-screen bg-white">
  <div class="contact-container">
    {% comment %} Breadcrumb {% endcomment %}
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Contact Us</span>
    </div>

    {% comment %} Page Header {% endcomment %}
    <div class="page-header">
      <h1 class="page-title">Get In Touch</h1>
      <p class="page-subtitle">We are here to help. Whether you have a question about our products, need design advice, or require assistance with your order.</p>
    </div>

    {% comment %} Contact Grid {% endcomment %}
    <div class="contact-grid">
      {% comment %} Contact Form {% endcomment %}
      <div class="contact-form">
        <h2 class="form-title">Send us a Message</h2>
        
        <form method="POST" action="/contact">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="contact_name">Name</label>
              <input 
                type="text" 
                name="contact[name]" 
                id="contact_name"
                class="form-input" 
                placeholder="Your Name"
                required
                aria-required="true"
              >
            </div>
            <div class="form-group">
              <label class="form-label" for="contact_email">Email</label>
              <input 
                type="email" 
                name="contact[email]" 
                id="contact_email"
                class="form-input" 
                placeholder="your@email.com"
                required
                aria-required="true"
              >
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="contact_phone">Phone</label>
              <input 
                type="tel" 
                name="contact[phone]" 
                id="contact_phone"
                class="form-input" 
                placeholder="+20 10 .... ...."
              >
            </div>
            <div class="form-group">
              <label class="form-label" for="contact_subject">Subject</label>
              <select name="contact[subject]" id="contact_subject" class="form-select" required aria-required="true">
                <option value="">Select subject...</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Product Question">Product Question</option>
                <option value="Order Support">Order Support</option>
                <option value="Design Consultation">Design Consultation</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="contact_message">Message</label>
            <textarea 
              name="contact[body]" 
              id="contact_message"
              class="form-textarea" 
              placeholder="Tell us how we can help..."
              required
              aria-required="true"
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">Send Message</button>
        </form>
      </div>

      {% comment %} Contact Information {% endcomment %}
      <div class="contact-info">
        <div class="info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4A35A" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="info-title">Address</h3>
          <div class="info-content">
            <p>123 Zamalek Street<br>Cairo, Egypt 11211<br>+20 Branches across Egypt</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4A35A" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3 class="info-title">Phone</h3>
          <div class="info-content">
            <p><a href="tel:+201001234567">+20 100 123 4567</a><br>
            <a href="tel:+201001234568">+20 100 123 4568</a><br>
            Sat-Thu: 10am-6pm (GMT+2)</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4A35A" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h3 class="info-title">Email</h3>
          <div class="info-content">
            <p><a href="mailto:info@shatta.com">info@shatta.com</a><br>
            <a href="mailto:support@shatta.com">support@shatta.com</a><br>
            Response time: 24 hours</p>
          </div>
        </div>
      </div>
    </div>

    {% comment %} FAQ Section {% endcomment %}
    <section class="faq-section">
      <h2 class="section-title">Frequently Asked Questions</h2>
      
      <div class="faq-container">
        <div class="faq-item">
          <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" aria-expanded="false">
            <span>What is your return policy?</span>
            <span class="faq-toggle">↓</span>
          </button>
          <div class="faq-answer">
            <p>We offer a 30-day return policy on all items. Products must be unused, undamaged, and in original packaging. Custom orders may have different terms.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" aria-expanded="false">
            <span>How long does shipping take?</span>
            <span class="faq-toggle">↓</span>
          </button>
          <div class="faq-answer">
            <p>Standard delivery typically takes 3-5 business days within Cairo and 5-7 days for other Egyptian cities. Express delivery options are available for an additional fee.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" aria-expanded="false">
            <span>Do you offer custom orders?</span>
            <span class="faq-toggle">↓</span>
          </button>
          <div class="faq-answer">
            <p>Yes! We offer custom products including bespoke colors, sizes, and designs. Please contact our design team at design@shatta.com to discuss your specific needs.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" aria-expanded="false">
            <span>Are your products eco-friendly?</span>
            <span class="faq-toggle">↓</span>
          </button>
          <div class="faq-answer">
            <p>We prioritize sustainability in our sourcing and production. Our products use natural, high-quality materials and we work with suppliers who follow ethical and sustainable practices.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" aria-expanded="false">
            <span>Do you offer bulk or wholesale pricing?</span>
            <span class="faq-toggle">↓</span>
          </button>
          <div class="faq-answer">
            <p>Absolutely! We offer special pricing for bulk orders and wholesale partners. Contact our B2B team at wholesale@shatta.com for more information.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  (function() {
    // Handle form submission
    const contactForm = document.querySelector('form[action="/contact"]');
    if (contactForm) {
      contactForm.addEventListener('submit', function(e) {
        // Shopify will handle the submission automatically
        // This is just for reference/potential custom handling
      });
    }
  })();
</script>
